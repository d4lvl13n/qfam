{
  "name": "quefaireamajorque",
  "version": "1.0.0",
  "private": true,
  "description": "Que faire à Majorque — site de réservation d'activités et guides à Majorque (React + WordPress headless)",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run generate-sitemap && tsc && vite build",
    "build:no-sitemap": "npm run lint && tsc && vite build",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "mallorca",
    "majorque",
    "tourisme",
    "react",
    "vite",
    "wordpress"
  ],
  "author": "Damien Larquey",
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "@vercel/edge": "^1.2.2",
    "framer-motion": "^10.16.0",
    "i18next": "^23.7.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "typescript": "^5.0.2",
    "vite": "^4.4.0",
    "vitest": "^0.34.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
